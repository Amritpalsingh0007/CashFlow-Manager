# ─── Brook Environment Variables ─────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ── JWT ───────────────────────────────────────────────────────────────────────
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-32-char-secret-in-production

# ── Database ──────────────────────────────────────────────────────────────────
# Neon Postgres connection strings
# Get these from your Neon dashboard: Project Settings → Connection details
# DATABASE_URL=postgresql://user:pass@ep-xyz.us-east-2.aws.neon.tech/db?sslmode=require
# DIRECT_URL=postgresql://user:pass@ep-xyz.us-east-2.aws.neon.tech/db?sslmode=require&pooler_mode=disabled

# ── Admin seed (used only on first run, when DB is empty) ─────────────────────
ADMIN_EMAIL=raj@brook.app
ADMIN_PASSWORD=change-me-before-deploy
ADMIN_NAME=Raj
ORG_NAME=Brook Transport
TRUCK_REG=MH-12-AB-1234
TRUCK_MODEL=Tata Prima
